---
import BaseLayout from "./BaseLayout.astro";
import Nav from "../components/Nav.astro";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: Date;
    tags: string[];
  };
}

const { frontmatter } = Astro.props;
const formattedDate = new Date(frontmatter.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${frontmatter.title} | Yasunori MAHATA`} description={frontmatter.description}>
  <Nav />
  <article class="relative z-10 max-w-3xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <header class="mb-8">
      <h1 class="text-4xl font-bold text-white mb-4">{frontmatter.title}</h1>
      <div class="flex items-center gap-4 text-gray-400 text-sm">
        <time datetime={frontmatter.date.toISOString()}>{formattedDate}</time>
        {
          frontmatter.tags.length > 0 && (
            <div class="flex gap-2">
              {frontmatter.tags.map((tag: string) => (
                <span class="bg-gray-700 text-gray-300 px-2 py-0.5 rounded text-xs">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
