---
const currentPath = Astro.url.pathname;
---

<nav class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
  <div class="flex items-center gap-6">
    <a
      href="/"
      class:list={[
        "text-sm font-medium transition-colors",
        currentPath === "/" ? "text-white" : "text-gray-400 hover:text-white",
      ]}
    >
      Home
    </a>
    <a
      href="/blog"
      class:list={[
        "text-sm font-medium transition-colors",
        currentPath.startsWith("/blog") ? "text-white" : "text-gray-400 hover:text-white",
      ]}
    >
      Blog
    </a>
  </div>
</nav>
